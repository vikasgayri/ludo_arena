# ---------- Backend (Spring Boot) ----------
# MongoDB connection string. Local: mongodb://localhost:27017/ludo_arena
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ludo_arena?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ludo_arena
# At least 32 random bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
# Allowed browser origin(s), comma separated. Exact origins or patterns (https://*.vercel.app). First = real site.
FRONTEND_URL=http://localhost:5173
# true when running behind a proxy/load balancer (Render, Nginx) so rate limiting sees the real client IP
TRUST_PROXY=false
# Optional: bootstrap the first SUPER_ADMIN on startup (only if none exists)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Optional SMTP (password reset mails). When MAIL_ENABLED=false links are logged instead (dev only).
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ludoarena.example
# Voice chat (WebRTC). STUN works on most Wi-Fi; add a TURN relay for mobile data (see docs/DEPLOYMENT.md section 7)
VOICE_ENABLED=true
VOICE_TURN_URLS=
VOICE_TURN_SECRET=
VOICE_TURN_USERNAME=
VOICE_TURN_CREDENTIAL=
# Payments are DISABLED by default. See README "Payment architecture" before enabling.
PAYMENTS_ENABLED=false
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ---------- Frontend (Vite) -> copy to frontend/.env ----------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=http://localhost:8080/ws
# Production (Vercel): VITE_API_BASE_URL=https://<service>.onrender.com/api/v1  VITE_WS_URL=https://<service>.onrender.com/ws
